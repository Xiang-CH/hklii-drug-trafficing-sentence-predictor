{
	"name": "drug-sentencing-predictor-backend",
	"private": true,
	"type": "module",
	"main": "dist/functions/*.js",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc && cp src/case_recommender_corpus.json dist/case_recommender_corpus.json",
		"start": "node dist/index.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@azure/functions": "^4.16.2",
		"@hono/node-server": "^1.19.7",
		"@hono/swagger-ui": "^0.6.1",
		"@hono/zod-openapi": "^1.5.1",
		"@hono/zod-validator": "^0.7.6",
		"@marplex/hono-azurefunc-adapter": "^1.0.1",
		"hono": "^4.9.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"tsx": "^4.19.3",
		"typescript": "^5.7.3",
		"vitest": "^3.0.9"
	}
}
